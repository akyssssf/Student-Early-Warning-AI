# Lingkungan: development | production. Default (kalau kosong) = production, yang MENOLAK start
# tanpa JWT_SECRET_KEY yang kuat. Untuk lokal pakai development.
APP_ENV=development

# MySQL 8 (XAMPP: user root, password kosong). Buat database dulu: lihat database/schema.sql
DATABASE_URL=mysql+pymysql://root:@localhost:3306/student_early_warning
# Untuk coba cepat tanpa MySQL, pakai SQLite:
# DATABASE_URL=sqlite:///sew.db

# Wajib di production: string acak minimal 32 karakter.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nilai ini juga dipakai frontend (JWT_SECRET_KEY di .env.local Next.js) untuk memverifikasi token.
JWT_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000

# Pendaftaran mandiri khusus mahasiswa (akun dosen/kaprodi/admin dibuat Admin lewat POST /api/v1/users)
ALLOW_SELF_REGISTER=true

# Hanya dipakai docker compose
# Pakai karakter yang aman untuk URL (huruf, angka, - _ .) karena dipakai di DATABASE_URL.
MYSQL_ROOT_PASSWORD=
