# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Alamat backend Flask (folder backend/)
BACKEND_URL=http://127.0.0.1:5000

# HARUS sama persis dengan JWT_SECRET_KEY di backend/.env (minimal 32 karakter).
# Frontend memakainya untuk memverifikasi tanda tangan token. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Saat `next dev` dan kosong, dipakai secret development bawaan backend (APP_ENV=development).
JWT_SECRET_KEY=
